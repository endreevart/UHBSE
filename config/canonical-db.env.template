# Template for canonical-db.env — copy to the repository root as canonical-db.env.
# canonical-db.env is git-ignored and must never be committed.
#
# Topology is fixed by artifacts/stage-03-implementation/physical-storage-plan.yaml:
#   service uhbse_canonical_dev on port 5436, schema canonical_evidence, PostgreSQL 16.
#
# Fill every PLACEHOLDER value locally. No secret, password, DSN or key material
# belongs in this template or in any repository artifact.

POSTGRES_DB=uhbse_canonical_dev
POSTGRES_USER=canonical_admin
POSTGRES_PASSWORD=PLACEHOLDER_SET_LOCALLY

# Client-side connection settings consumed by the migration runner.
CANONICAL_DB_HOST=localhost
CANONICAL_DB_PORT=5436
CANONICAL_DB_NAME=uhbse_canonical_dev
CANONICAL_DB_ADMIN_USER=canonical_admin
CANONICAL_DB_ADMIN_PASSWORD=PLACEHOLDER_SET_LOCALLY

# Optional: separate disposable database used only by the migration integration suite.
# It is created and dropped by the suite and must never point at a raw source database.
CANONICAL_TEST_DB_NAME=uhbse_canonical_migration_test

# Canonical HMAC secret is runtime-only and is NOT part of Changeset 01.
# It is intentionally absent here; Changeset 01 creates empty storage only.
