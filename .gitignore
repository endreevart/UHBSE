# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local config
private/sources.yaml
private/uhbse-operator-limited.password
private/vault-*
db.env
db-audit.env
db-kgz.env
canonical-db.env

# Vault TLS material and any local init artifacts (never commit)
ops/vault/tls/
ops/vault/pgp/
ops/vault/operator-custody/
ops/vault/**/*.pem
ops/vault/**/*init*.json
ops/vault/**/unseal*
ops/vault/**/root-token*
ops/vault/**/*.asc
ops/vault/**/*.gpg
ops/vault/**/*secret_id*
ops/vault/**/*role_id*

# Database dumps (keep local, never commit)
*.dump
dumps/

# Artifacts with raw samples (aggregates in artifacts/stage-01/ are OK)
artifacts/**/raw/
artifacts/**/samples/

# External review bundles (generated locally, not versioned)
artifacts/external-review/
.idea/
*.swp
